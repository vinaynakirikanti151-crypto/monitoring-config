{
  "id": 100,
  "type": "table",
  "title": "Stale CronJobs — 90+ Days",
  "description": "Latest CronJob records observed within the last 2 days. Includes jobs created more than 90 days ago whose last scheduled time is more than 90 days ago or is not recorded. Missing timestamps require verification. Recently observed does not guarantee the resource still exists. Sorted by creation date, oldest first.",
  "gridPos": {
    "h": 18,
    "w": 24,
    "x": 0,
    "y": 0
  },
  "timeFrom": "2d",
  "datasource": {
    "type": "elasticsearch",
    "uid": "REPLACE_WITH_LATEST_INDEX_DATASOURCE_UID"
  },
  "targets": [
    {
      "refId": "A",
      "datasource": {
        "type": "elasticsearch",
        "uid": "REPLACE_WITH_LATEST_INDEX_DATASOURCE_UID"
      },
      "queryType": "lucene",
      "query": "labels.k8s_cluster_name:${cluster:lucene} AND labels.k8s_resource_name:\"cronjobs\" AND @timestamp:[now-2d TO now] AND labels.creationTime:{* TO now-90d} AND (labels.lastScheduleTime:{* TO now-90d} OR (NOT _exists_:labels.lastScheduleTime))",
      "alias": "",
      "timeField": "@timestamp",
      "metrics": [
        {
          "id": "1",
          "type": "min",
          "field": "labels.creationTime"
        },
        {
          "id": "2",
          "type": "max",
          "field": "labels.lastScheduleTime"
        },
        {
          "id": "3",
          "type": "max",
          "field": "labels.lastSuccessfulTime"
        },
        {
          "id": "4",
          "type": "max",
          "field": "@timestamp"
        }
      ],
      "bucketAggs": [
        {
          "id": "5",
          "type": "terms",
          "field": "labels.k8s_cluster_name",
          "settings": {
            "min_doc_count": "1",
            "size": "100",
            "order": "asc",
            "orderBy": "_term"
          }
        },
        {
          "id": "6",
          "type": "terms",
          "field": "kubernetes.namespace",
          "settings": {
            "min_doc_count": "1",
            "size": "100",
            "order": "asc",
            "orderBy": "_term"
          }
        },
        {
          "id": "7",
          "type": "terms",
          "field": "labels.cronjob_uid",
          "settings": {
            "min_doc_count": "1",
            "size": "10000",
            "order": "asc",
            "orderBy": "_term"
          }
        },
        {
          "id": "8",
          "type": "terms",
          "field": "labels.cronjob_name",
          "settings": {
            "min_doc_count": "1",
            "size": "1",
            "order": "asc",
            "orderBy": "_term"
          }
        },
        {
          "id": "9",
          "type": "terms",
          "field": "labels.user",
          "settings": {
            "min_doc_count": "1",
            "size": "1",
            "order": "asc",
            "orderBy": "_term",
            "missing": "Not recorded"
          }
        },
        {
          "id": "10",
          "type": "terms",
          "field": "labels.nominated_users",
          "settings": {
            "min_doc_count": "1",
            "size": "100",
            "order": "asc",
            "orderBy": "_term",
            "missing": "Not recorded"
          }
        },
        {
          "id": "11",
          "type": "terms",
          "field": "labels.schedule",
          "settings": {
            "min_doc_count": "1",
            "size": "1",
            "order": "asc",
            "orderBy": "_term",
            "missing": "Not recorded"
          }
        }
      ]
    }
  ],
  "transformations": [
    {
      "id": "sortBy",
      "options": {
        "fields": {},
        "sort": [
          {
            "field": "Min labels.creationTime",
            "desc": false
          }
        ]
      }
    },
    {
      "id": "organize",
      "options": {
        "excludeByName": {
          "labels.cronjob_uid": true
        },
        "indexByName": {
          "labels.k8s_cluster_name": 0,
          "kubernetes.namespace": 1,
          "labels.cronjob_name": 2,
          "labels.user": 3,
          "labels.nominated_users": 4,
          "labels.schedule": 5,
          "Min labels.creationTime": 6,
          "Max labels.lastScheduleTime": 7,
          "Max labels.lastSuccessfulTime": 8,
          "Max @timestamp": 9,
          "labels.cronjob_uid": 10
        },
        "renameByName": {
          "labels.k8s_cluster_name": "Cluster",
          "kubernetes.namespace": "Namespace",
          "labels.cronjob_name": "CronJob Name",
          "labels.user": "Owner",
          "labels.nominated_users": "Nominated Users",
          "labels.schedule": "Cron Schedule",
          "Min labels.creationTime": "Created At",
          "Max labels.lastScheduleTime": "Last Scheduled Time",
          "Max labels.lastSuccessfulTime": "Last Successful Run",
          "Max @timestamp": "Last Seen",
          "labels.cronjob_uid": "CronJob UID"
        }
      }
    }
  ],
  "fieldConfig": {
    "defaults": {
      "custom": {
        "align": "auto",
        "filterable": true,
        "cellOptions": {
          "type": "auto"
        }
      },
      "noValue": "Not recorded"
    },
    "overrides": [
      {
        "matcher": {
          "id": "byRegexp",
          "options": "^(Created At|Last Scheduled Time|Last Successful Run|Last Seen)$"
        },
        "properties": [
          {
            "id": "unit",
            "value": "dateTimeAsLocal"
          },
          {
            "id": "custom.width",
            "value": 210
          }
        ]
      },
      {
        "matcher": {
          "id": "byName",
          "options": "CronJob Name"
        },
        "properties": [
          {
            "id": "custom.width",
            "value": 350
          }
        ]
      }
    ]
  },
  "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
      "show": false
    },
    "sortBy": []
  }
}